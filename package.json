{
  "name": "user-management-system",
  "version": "1.0.0",
  "description": "User Management System following PMS 3-Layer Architecture",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsc && concurrently \"tsc -w\" \"nodemon\"",
    "build": "tsc",
    "prod": "node dist/server.js",
    "start": "npm run build && npm run prod",
    "format": "prettier --write \"src/**/*.{ts,js,json}\""
  },
